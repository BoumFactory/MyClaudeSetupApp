          },
          {
            "formulation_bo": "un descriptif donne les éléments généraux du thème et met en contexte les contenus mathématiques ;",
            "type_hint": "unknown",
            "sous_domaine_hint": "Trace écrite",
            "niveau_assigne": null,
            "source": {
