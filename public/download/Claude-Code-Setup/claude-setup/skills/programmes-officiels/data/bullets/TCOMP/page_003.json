            }
          },
          {
            "formulation_bo": "le second volet précise l’ensemble des contenus et capacités attendues. L’objectif est de traiter l’ensemble des contenus et capacités attendues au travers des thèmes d’étude. Chaque thème d’étude contient les rubriques suivantes :",
            "type_hint": "unknown",
            "sous_domaine_hint": "Trace écrite",
            "niveau_assigne": null,
            "source": {
              "pdf": "tcomp.pdf",
              "page": 3,
